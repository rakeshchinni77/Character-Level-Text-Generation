# Dataset Configuration
DATASET_PATH=input/shakespeare.txt

# Training Hyperparameters
LEARNING_RATE=0.001
EPOCHS=10
BATCH_SIZE=64
SEQ_LENGTH=100

# LSTM Model Configuration
LSTM_EMBED_DIM=128
LSTM_HIDDEN_DIM=256
LSTM_LAYERS=2

# Transformer Model Configuration
TRANSFORMER_EMBED_DIM=128
TRANSFORMER_HEADS=4
TRANSFORMER_LAYERS=2
TRANSFORMER_FF_DIM=512

# Directory Paths
MODEL_SAVE_DIR=models
RESULTS_DIR=results
SAVED_DIR=saved
